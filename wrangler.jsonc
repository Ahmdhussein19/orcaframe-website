{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "orcaframe",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-09-09",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "workers_dev": false,
  "preview_urls": true,
  "routes": [
    { "pattern": "orcaframe.com", "custom_domain": true },
    { "pattern": "www.orcaframe.com", "custom_domain": true }
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },
  "keep_vars": true
}
